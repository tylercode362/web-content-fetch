# The UI is loopback-only by default. Expose it through an approved gateway when needed.
WEB_CONTENT_FETCH_PORT=8092
WEB_CONTENT_FETCH_BRIDGE_URL=http://host.docker.internal:8788
WEB_CONTENT_FETCH_CALLBACK_URL=http://host.docker.internal:8092/api/bridge/callback
WEB_CONTENT_FETCH_CALLBACK_ALLOWED_HOSTS=host.docker.internal
WEB_CONTENT_FETCH_MAX_CONCURRENT_JOBS=5
WEB_CONTENT_FETCH_KOBO_MAX_WIDTH=1404
WEB_CONTENT_FETCH_KOBO_MAX_HEIGHT=1872
WEB_CONTENT_FETCH_MEMORY_LIMIT=1g
WEB_CONTENT_FETCH_MEMORY_RESERVATION=256m
WEB_CONTENT_FETCH_PIDS_LIMIT=256

# Pairing is completed in the UI and must not be stored in this file.
