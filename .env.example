# The UI is reachable only through Local Gateway; WCF-to-Bridge traffic stays on
# the dedicated internal Docker networks declared in Compose.
WEB_CONTENT_FETCH_MAX_CONCURRENT_JOBS=5
WEB_CONTENT_FETCH_KOBO_MAX_WIDTH=1404
WEB_CONTENT_FETCH_KOBO_MAX_HEIGHT=1872
WEB_CONTENT_FETCH_MEMORY_LIMIT=1g
WEB_CONTENT_FETCH_MEMORY_RESERVATION=256m
WEB_CONTENT_FETCH_PIDS_LIMIT=256

# Pairing is completed in the UI and must not be stored in this file.

# Optional when the public Gateway origin is fixed; otherwise forwarded Gateway headers are checked.
# WEB_CONTENT_FETCH_ALLOWED_ORIGIN=http://127.0.0.1:8088

# Only for the opt-in compose.bridge-auth.yaml after environment/access approval.
# WEB_CONTENT_FETCH_AUTH_VOLUME=verified-existing-volume-name
